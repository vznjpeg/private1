{
  "manifest_version": 3,
  "name": "Reddit Thread Scraper",
  "description": "Scrape Reddit comment threads with ease",
  "version": "1.0.0",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "*://reddit.com/*",
    "*://*.reddit.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Reddit Thread Scraper",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.reddit.com/*",
        "*://reddit.com/*"
      ],
      "js": [
        "content-scripts/reddit.js"
      ]
    }
  ]
}
